<+><?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<androidx.coordinatorlayout.widget.CoordinatorLayout\r\n    xmlns:android=\"http://schemas.android.com/apk/res/android\"\r\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\r\n    android:layout_width=\"match_parent\"\r\n    android:layout_height=\"match_parent\"\r\n    android:background=\"@color/white\">\r\n\r\n    <ScrollView\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"match_parent\"\r\n        android:fillViewport=\"true\">\r\n\r\n        <LinearLayout\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:orientation=\"vertical\"\r\n            android:padding=\"12dp\">\r\n\r\n            <!-- Contenedor subir imagen -->\r\n            <LinearLayout\r\n                android:id=\"@+id/layoutImagen\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"160dp\"\r\n                android:layout_marginBottom=\"12dp\"\r\n                android:background=\"@drawable/bg_dashed\"\r\n                android:gravity=\"center\"\r\n                android:orientation=\"vertical\"\r\n                android:clickable=\"true\"\r\n                android:focusable=\"true\">\r\n\r\n                <ImageView\r\n                    android:id=\"@+id/iconAddPhoto\"\r\n                    android:layout_width=\"32dp\"\r\n                    android:layout_height=\"32dp\"\r\n                    android:src=\"@drawable/outline_add_24\"\r\n                    app:tint=\"@color/cian_botones\" />\r\n\r\n                <TextView\r\n                    android:id=\"@+id/txtAddPhoto\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:layout_marginTop=\"8dp\"\r\n                    android:text=\"Subir imagen o abrir cámara\"\r\n                    android:textSize=\"13sp\"\r\n                    android:textColor=\"@color/cian_botones\"\r\n                    android:fontFamily=\"@font/text_app\"/>\r\n\r\n\r\n            </LinearLayout>\r\n\r\n            <!-- Imagen real (oculta al inicio) -->\r\n            <ImageView\r\n                android:id=\"@+id/imgMascota\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"160dp\"\r\n                android:scaleType=\"centerCrop\"\r\n                android:visibility=\"gone\"/>\r\n\r\n            <!-- Nombre -->\r\n            <EditText\r\n                android:id=\"@+id/etNombre\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:layout_marginTop=\"10dp\"\r\n                android:hint=\"Nombre de la mascota\"\r\n                android:textSize=\"14sp\"\r\n                android:fontFamily=\"@font/text_app\"/>\r\n\r\n            <!-- Teléfono -->\r\n\r\n            <!-- Estado -->\r\n            <EditText\r\n                android:id=\"@+id/etTelefono\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:layout_marginTop=\"8dp\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:hint=\"Teléfono de contacto\"\r\n                android:inputType=\"phone\"\r\n                android:textSize=\"14sp\" />\r\n\r\n            <TextView\r\n                android:layout_marginTop=\"10dp\"\r\n                android:text=\"Estado del animal\"\r\n                android:textStyle=\"bold\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_titulos\"/>\r\n\r\n            <CheckBox\r\n                android:id=\"@+id/cbPerdido\"\r\n                android:text=\"Perdido\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:buttonTint=\"@color/rosita_fondoss_tarjetas_alertaslev\"/>\r\n\r\n            <CheckBox\r\n                android:id=\"@+id/cbAdopcion\"\r\n                android:text=\"En adopción\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:buttonTint=\"@color/rosita_fondoss_tarjetas_alertaslev\"/>\r\n\r\n            <!-- Tipo -->\r\n            <TextView\r\n                android:layout_marginTop=\"10dp\"\r\n                android:text=\"Tipo de mascota\"\r\n                android:textStyle=\"bold\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_titulos\"/>\r\n\r\n            <CheckBox\r\n                android:id=\"@+id/cbPerro\"\r\n                android:text=\"Perro\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:buttonTint=\"@color/rosita_fondoss_tarjetas_alertaslev\"/>\r\n\r\n            <CheckBox\r\n                android:id=\"@+id/cbGato\"\r\n                android:text=\"Gato\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:buttonTint=\"@color/rosita_fondoss_tarjetas_alertaslev\"/>\r\n\r\n            <CheckBox\r\n                android:id=\"@+id/cbOtro\"\r\n                android:text=\"Otro\"\r\n                android:textSize=\"13sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:buttonTint=\"@color/rosita_fondoss_tarjetas_alertaslev\"/>\r\n\r\n            <EditText\r\n                android:id=\"@+id/etOtroTipo\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:hint=\"Especificar otro tipo\"\r\n                android:textSize=\"13sp\"\r\n                android:visibility=\"gone\"\r\n                android:fontFamily=\"@font/text_app\"/>\r\n\r\n            <!-- Edad -->\r\n            <EditText\r\n                android:id=\"@+id/etEdad\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:layout_marginTop=\"8dp\"\r\n                android:hint=\"Edad aproximada\"\r\n                android:textSize=\"14sp\"\r\n                android:inputType=\"number\"\r\n                android:fontFamily=\"@font/text_app\"/>\r\n\r\n            <!-- Chip -->\r\n\r\n            <!-- Info adicional -->\r\n            <EditText\r\n                android:id=\"@+id/etChip\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:layout_marginTop=\"8dp\"\r\n                android:fontFamily=\"@font/text_app\"\r\n                android:hint=\"Número de chip (opcional)\"\r\n                android:textSize=\"14sp\" />\r\n\r\n            <EditText\r\n                android:id=\"@+id/etInfoAdicional\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:layout_marginTop=\"8dp\"\r\n                android:hint=\"Información adicional (opcional)\"\r\n                android:textSize=\"14sp\"\r\n                android:minLines=\"2\"\r\n                android:inputType=\"textMultiLine\"\r\n                android:fontFamily=\"@font/text_app\"/>\r\n\r\n            <!-- Checkbox legal -->\r\n            <CheckBox\r\n                android:id=\"@+id/checkLegal\"\r\n                android:layout_marginTop=\"10dp\"\r\n                android:text=\"Confirmo que la imagen es mía o tengo permiso para publicarla y que no contiene personas identificables\"\r\n                android:textSize=\"12sp\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:buttonTint=\"@color/rosita_fondoss_tarjetas_alertaslev\"/>\r\n\r\n            <!-- Publicar -->\r\n            <Button\r\n                android:id=\"@+id/btnPublicar\"\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"44dp\"\r\n                android:layout_marginTop=\"14dp\"\r\n                android:enabled=\"false\"\r\n                android:text=\"Publicar\"\r\n                android:textSize=\"14sp\"\r\n                style=\"@style/BotonPetFect\"/>\r\n\r\n        </LinearLayout>\r\n\r\n    </ScrollView>\r\n\r\n</androidx.coordinatorlayout.widget.CoordinatorLayout>\r\n
