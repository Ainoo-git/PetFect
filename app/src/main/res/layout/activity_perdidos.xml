<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!--    <TextView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Animales Perdidos"-->
<!--        android:textSize="24sp"-->
<!--        android:textStyle="bold"-->
<!--        android:padding="16dp"-->
<!--        android:textColor="#333333"/>-->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tarjeta 1 - Perro -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
               >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Foto del animal -->
                    <ImageView
                        android:id="@+id/fotoPerro1"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src=""
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto del perro"/>

                    <!-- Contenido central -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <!-- Primera línea: Nombre y Raza -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nombrePerro1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#333333"/>

                            <TextView
                                android:id="@+id/razaPerro1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perro"
                                android:textSize="14sp"
                                android:background=""
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:layout_marginStart="8dp"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                        <!-- Zona donde se perdió -->
                        <TextView
                            android:id="@+id/zonaPerro1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pozuelo de Alarcón"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>

                        <!-- Última vez visto -->
                        <TextView
                            android:id="@+id/ultimaVezPerro1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visto por última vez: 15 Feb 2024"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <!-- Flecha para ver detalles -->
                    <ImageView
                        android:id="@+id/flechaPerro1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/flecha_seguir"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="Ver detalles"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta 2 - Gato -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/fotoGato1"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src=""
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto del gato"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nombreGato1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gochume"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#333333"/>

                            <TextView
                                android:id="@+id/razaGato1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gato"
                                android:textSize="14sp"
                                android:background=""
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:layout_marginStart="8dp"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/zonaGato1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Majadahonda"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/ultimaVezGato1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visto por última vez: 14 Feb 2024"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/flechaGato1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/flecha_seguir"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="Ver detalles"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta 3 - Perro adicional -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:cardCornerRadius="12dp"
                android:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/fotoPerro2"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src=""
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto del perro"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nombrePerro2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kifkif"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#333333"/>

                            <TextView
                                android:id="@+id/razaPerro2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perro"
                                android:textSize="14sp"
                                android:background=""
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:layout_marginStart="8dp"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/zonaPerro2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boadilla del Monte"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/ultimaVezPerro2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visto por última vez: 13 Feb 2024"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/flechaPerro2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/flecha_seguir"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="Ver detalles"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>