<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/cian_botones"
        android:title="@string/detalle_mascota"
        android:titleTextColor="@color/white"
        app:titleCentered="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/background">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@color/card_background">

                <ImageView
                    android:id="@+id/imgAccion"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/foto_mascota"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_mascota_demo"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tipo_estado_demo"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/cian_oscuro_iconos"
                    android:background="@color/cian_clarito_bordes"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/layoutDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/txtEdad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/edad_label_demo"
                        android:textSize="16sp"
                        android:textColor="@color/gris"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/txtChip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/chip_label_demo"
                        android:textSize="16sp"
                        android:textColor="@color/gris"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/txtTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/telefono_label_demo"
                        android:textSize="16sp"
                        android:textColor="@color/gris"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/txtInfoAdicional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/info_adicional_label_demo"
                        android:textSize="16sp"
                        android:textColor="@color/gris"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/txtMostrarMasInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mostrar_mas"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/cian_botones"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEditar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/editar"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/cian_botones"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnEliminar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/eliminar"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/cardview_shadow_start_color"
                        android:padding="12dp"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

</LinearLayout>