<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <!--  IMAGEN  -->
            <LinearLayout android:id="@+id/layoutImagen" android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_dashed" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/outline_add_24" app:tint="@color/cian_botones"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/subir_imagen_camara" android:textColor="@color/cian_botones" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:id="@+id/imgMascota" android:layout_width="match_parent" android:layout_height="170dp" android:scaleType="centerCrop" android:visibility="gone"/>
            <!--  NOMBRE  -->
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nombre_mascota"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--  TELÉFONO  -->
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTelefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/telefono_contacto" android:inputType="phone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--  ESTADO  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/estado_animal" android:textStyle="bold" android:textSize="15sp"/>
            <RadioGroup android:id="@+id/rgEstado" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbPerdido" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/perdido"/>
                <RadioButton android:id="@+id/rbAdopcion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/en_adopcion"/>
            </RadioGroup>
            <!--  TIPO  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/tipo_mascota" android:textStyle="bold" android:textSize="15sp"/>
            <RadioGroup android:id="@+id/rgTipo" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbPerro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/perro"/>
                <RadioButton android:id="@+id/rbGato" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gato"/>
                <RadioButton android:id="@+id/rbOtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/otro"/>
            </RadioGroup>
            <!--  OTRO  -->
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilOtroTipo" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="8dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOtroTipo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/especificar_otro_tipo"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--  EDAD  -->
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEdad" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/edad_aproximada" android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--  CHIP  -->
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etChip" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/numero_chip_opcional"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--  INFO  -->
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etInfoAdicional" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/info_adicional_opcional" android:minLines="3" android:gravity="top" android:inputType="textMultiLine"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--  LEGAL  -->
            <CheckBox android:id="@+id/checkLegal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/confirmo_imagen"/>
            <!--  BOTÓN  -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPublicar" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:text="@string/publicar" android:enabled="false" app:cornerRadius="18dp" app:backgroundTint="@color/cian_botones"/>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>