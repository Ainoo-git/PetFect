<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- IMAGEN -->
            <LinearLayout
                android:id="@+id/layoutImagen"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_dashed"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/outline_add_24"
                    app:tint="@color/cian_botones" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Subir imagen o abrir cámara"
                    android:textColor="@color/cian_botones"
                    android:textSize="14sp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgMascota"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <!-- NOMBRE -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre de la mascota"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TELÉFONO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Teléfono de contacto"
                    android:inputType="phone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ESTADO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Estado del animal"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <RadioGroup
                android:id="@+id/rgEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbPerdido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perdido"/>

                <RadioButton
                    android:id="@+id/rbAdopcion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En adopción"/>

            </RadioGroup>

            <!-- TIPO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tipo de mascota"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <RadioGroup
                android:id="@+id/rgTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbPerro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perro"/>

                <RadioButton
                    android:id="@+id/rbGato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gato"/>

                <RadioButton
                    android:id="@+id/rbOtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Otro"/>

            </RadioGroup>

            <!-- OTRO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOtroTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOtroTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Especificar otro tipo"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- EDAD -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Edad aproximada"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CHIP -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de chip (opcional)"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- INFO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInfoAdicional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Información adicional (opcional)"
                    android:minLines="3"
                    android:gravity="top"
                    android:inputType="textMultiLine"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- LEGAL -->
            <CheckBox
                android:id="@+id/checkLegal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Confirmo que la imagen es mía o tengo permiso para publicarla"/>

            <!-- BOTÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:text="Publicar"
                android:enabled="false"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/cian_botones"/>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>