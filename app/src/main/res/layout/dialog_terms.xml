<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80FFC3C3">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:padding="16dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Términos y Políticas de Privacidad"
                android:textColor="#FF8C8C"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/tvLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver documento completo"
                android:textColor="#FF8C8C"
                android:layout_marginTop="8dp"/>

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:text="(Aquí van los términos completos)" />
            </ScrollView>

            <CheckBox
                android:id="@+id/checkAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="He leído y acepto"
                android:textColor="#000000"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:text="Cancelar"
                    android:textColor="#FF8C8C"
                    android:background="@android:color/transparent"/>

                <Button
                    android:id="@+id/btnAccept"
                    android:text="Aceptar"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:backgroundTint="#FF8C8C"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>