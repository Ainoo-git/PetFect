<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:padding="12dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_gravity="center"
        card_view:cardCornerRadius="22dp"
        card_view:cardElevation="12dp"
        card_view:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <!--  TITULO  -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terminos_politicas"
                android:textColor="@color/cian_oscuro_iconos"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />
            <!--  SUBTEXTO  -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/lee_info_continuar"
                android:textColor="@color/gris"
                android:textSize="13sp"
                android:gravity="center" />
            <!--  BOTONES TEXTO  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTerminos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/cian_clarito_bordes"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/terminos"
                    android:textColor="@color/cian_oscuro_iconos"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvPrivacidad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/cian_clarito_bordes"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/privacidad"
                    android:textColor="@color/cian_oscuro_iconos"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!--  CHECK  -->
            <CheckBox
                android:id="@+id/checkAccept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/cian_botones"
                android:text="@string/he_leido_acepto"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <!--  BOTONES  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/cian_botones"
                    android:text="@string/cancelar"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/cian_botones"
                    android:enabled="false"
                    android:text="@string/aceptar"
                    android:textColor="@color/white" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>