<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80FFC3C3">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Términos y Políticas de Privacidad"
                android:textColor="#FF8C8C"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <!-- LINK -->
            <TextView
                android:id="@+id/tvLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver documento completo"
                android:textColor="#FF8C8C"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <!-- SCROLL -->
            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:text="(Aquí van los términos completos)" />

            </ScrollView>

            <!-- CHECK -->
            <CheckBox
                android:id="@+id/checkAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="He leído y acepto"
                android:textColor="#000000"
                android:layout_marginTop="14dp"/>

            <!-- BOTONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancelar"
                    android:textColor="#FF8C8C"
                    android:background="@android:color/transparent"/>

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aceptar"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:backgroundTint="#FF8C8C"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>