<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- APPBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="Atribuciones"
            android:background="@color/rosita_fondoss_tarjetas_alertaslev"
            android:titleTextColor="@color/white"
            app:navigationIcon="@drawable/outline_arrow"
            app:titleCentered="true"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atribuciones"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <!-- RECURSOS GRÁFICOS -->
        <TextView
            android:text="Recursos gráficos"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Iconos"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Plataforma: Flaticon"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Autores:"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/linkFlaticon"
            android:text="Fuente: https://www.flaticon.es/"
            android:textColor="@color/coral_alertasimp_errores"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Licencia: Según términos de uso de Flaticon con atribución"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- CONTENIDO AUDIOVISUAL -->
        <TextView
            android:text="Contenido audiovisual"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Guion y asistencia textual"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="El audio del video promocional fue generado mediante IA"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- IA -->
        <TextView
            android:text="Herramienta: ChatGPT"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Proveedor: OpenAI"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/linkChatGPT"
            android:text="Fuente: https://chatgpt.com/"
            android:textColor="@color/coral_alertasimp_errores"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>