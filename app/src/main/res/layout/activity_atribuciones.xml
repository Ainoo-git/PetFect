<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <!--  APPBAR  -->
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:title="@string/atribuciones" android:background="@color/rosita_fondoss_tarjetas_alertaslev" android:titleTextColor="@color/white" app:navigationIcon="@drawable/outline_arrow" app:titleCentered="true"/>
    </com.google.android.material.appbar.AppBarLayout>
    <!--  CONTENIDO SCROLL  -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="?attr/actionBarSize" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <!--  TÍTULO  -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/atribuciones" android:textSize="24sp" android:textStyle="bold" android:paddingBottom="16dp"/>
            <!--  RECURSOS GRÁFICOS  -->
            <TextView android:text="@string/recursos_graficos" android:textStyle="bold" android:textSize="18sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/iconos" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/plataforma_flaticon" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/autores" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/linkFlaticon" android:text="@string/fuente_flaticon" android:textColor="@color/coral_alertasimp_errores" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/licencia_flaticon" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <!--  CONTENIDO AUDIOVISUAL  -->
            <TextView android:text="@string/contenido_audiovisual" android:textStyle="bold" android:textSize="18sp" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/guion_asistencia_textual" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/audio_video_ia" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <!--  IA  -->
            <TextView android:text="@string/herramienta_chatgpt" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/proveedor_openai" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/linkChatGPT" android:text="@string/fuente_chatgpt" android:textColor="@color/coral_alertasimp_errores" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>