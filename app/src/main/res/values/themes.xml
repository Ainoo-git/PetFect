<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- BASE THEME -->
    <style name="Base.Theme.PetFect" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cian_botones</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cian_oscuro_iconos</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/rosita_fondoss_tarjetas_alertaslev</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/petfect_background</item>
        <!-- Fuente global: android views + Material3 components -->
        <item name="android:fontFamily">@font/text_app</item>
        <item name="fontFamily">@font/text_app</item>
    </style>

    <!-- TU TEMA PRINCIPAL -->
    <style name="Theme.PetFect" parent="Base.Theme.PetFect" />

    <!-- ESTILOS REUTILIZABLES -->
    <style name="TituloApp">
        <item name="android:fontFamily">@font/text_titulos</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TituloLegal">
        <item name="android:fontFamily">@font/text_titulos</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">12dp</item>
    </style>

    <style name="TextLegal">
        <item name="android:fontFamily">@font/text_app</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
    </style>


</resources>